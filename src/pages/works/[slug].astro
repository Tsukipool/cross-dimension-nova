---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ParticleField from '../../components/ParticleField.astro';
import { getWorks, getNextWork, typeMeta, type Work } from '../../lib/works';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work, works },
  }));
}

interface Props {
  work: Work;
  works: Work[];
}

const { work, works } = Astro.props;
const { Content, headings } = await render(work);

const meta = typeMeta[work.data.type];
const next = getNextWork(works, work.id);
const isNovel = work.data.type === 'novel';
const isVideo = work.data.type === 'video';
const coverRatio = isVideo ? 'landscape' : isNovel ? 'book' : 'portrait';
const chapters = headings.filter((heading) => heading.depth === 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': isNovel ? 'ShortStory' : isVideo ? 'VideoObject' : 'CreativeWork',
  name: work.data.title,
  alternateName: work.data.english,
  description: work.data.summary,
  genre: work.data.category,
  creator: { '@type': 'Organization', name: '跨次元新星' },
  datePublished: work.data.date,
  image: new URL(work.data.cover, Astro.site).href,
  ...(isVideo && work.data.video
    ? {
        contentUrl: new URL(work.data.video, Astro.site).href,
        thumbnailUrl: new URL(work.data.cover, Astro.site).href,
      }
    : {}),
};
---

<BaseLayout
  title={work.data.title}
  description={work.data.summary}
  image={work.data.cover}
  page={`work-${work.data.type}`}
>
  {isNovel && (
    <div class="reading-bar" aria-hidden="true">
      <span data-reading-progress></span>
    </div>
  )}

  <article class="work" style={`--work-accent: ${work.data.accent}`}>
    <header class="work-hero">
      <div class="work-hero__ambient" aria-hidden="true">
        <img src={work.data.cover} alt="" loading="eager" />
        <span></span>
      </div>

      <ParticleField
        variant="dust"
        density={0.55}
        accent={work.data.accent}
        opacity={0.5}
        class="work-hero__particles"
      />

      <div class="container">
        <div class="work-crumb" data-reveal>
          <a href="/works/" data-nav-link class="work-crumb__back">
            <Icon name="arrowLeft" size={13} />
            <span>作品档案</span>
          </a>
          <div class="work-crumb__meta">
            <span>{meta.en}</span>
            <span class="work-crumb__dot"></span>
            <span>N° {work.data.serial}</span>
            <span class="work-crumb__dot"></span>
            <span>{work.data.year}</span>
          </div>
        </div>

        <div class="work-hero__grid">
          <div class="work-hero__copy">
            <p class="eyebrow" data-reveal>{work.data.category} / {meta.label}</p>
            <h1 class="work-hero__title" data-reveal style="--reveal-delay: .06s">{work.data.title}</h1>
            <p class="work-hero__english" data-reveal style="--reveal-delay: .1s">{work.data.english}</p>
            <p class="work-hero__summary" data-reveal style="--reveal-delay: .14s">{work.data.summary}</p>

            <div class="work-hero__facts" data-reveal style="--reveal-delay: .18s">
              <div><span>YEAR</span><strong>{work.data.year}</strong></div>
              <div>
                <span>{isNovel ? 'READING TIME' : isVideo ? 'DURATION' : 'FORMAT'}</span>
                <strong>{isNovel ? work.data.readingTime : isVideo ? work.data.duration : 'DIGITAL ART'}</strong>
              </div>
              <div><span>CATEGORY</span><strong>{meta.label}</strong></div>
            </div>

            <div class="work-hero__tags" data-reveal style="--reveal-delay: .22s">
              {work.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>

          <div class="work-hero__visual" data-reveal="scale" style="--reveal-delay: .1s">
            <div class="work-hero__cover-tilt" data-tilt>
              <div class:list={['work-cover', `work-cover--${coverRatio}`]}>
                <img src={work.data.cover} alt={`${work.data.title} 主视觉`} width="1200" height="1500" loading="eager" />
                <span class="work-cover__shade"></span>

                {isVideo && (
                  <button
                    class="work-cover__play"
                    type="button"
                    data-open-video
                    data-video-src={work.data.video}
                    data-video-poster={work.data.cover}
                    data-cursor-label="Play"
                    aria-label={`播放 ${work.data.title}`}
                  >
                    <span class="work-cover__play-ring">
                      <svg viewBox="0 0 120 120" aria-hidden="true">
                        <defs>
                          <path id="work-play-path" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" />
                        </defs>
                        <text>
                          <textPath href="#work-play-path">PLAY THE FILM · CROSS-DIMENSION NOVA · </textPath>
                        </text>
                      </svg>
                    </span>
                    <span class="work-cover__play-center"><Icon name="play" size={22} /></span>
                  </button>
                )}

                <span class="work-cover__serial">N° {work.data.serial}</span>
                <span class="work-cover__label">{meta.en} / CXN</span>
              </div>
            </div>
            <span class="work-hero__vertical" aria-hidden="true">{work.data.english}</span>
          </div>
        </div>
      </div>
    </header>

    <section class:list={['work-content', { 'work-content--paper': isNovel }]} aria-label="作品内容">
      <div class="container">
        <div class="work-content__grid">
          <aside class="work-aside">
            <div class="work-aside__sticky">
              <p class="eyebrow" data-reveal>DETAILS / 作品信息</p>

              <dl class="work-info" data-reveal style="--reveal-delay: .06s">
                <div><dt>类别</dt><dd>{work.data.category}</dd></div>
                <div><dt>年份</dt><dd>{work.data.year}</dd></div>
                <div><dt>编号</dt><dd>N° {work.data.serial}</dd></div>
                {isVideo && <div><dt>片长</dt><dd>{work.data.duration} · 无声</dd></div>}
                {isNovel && <div><dt>阅读</dt><dd>{work.data.readingTime}</dd></div>}
              </dl>

              {work.data.credits.length > 0 && (
                <div class="work-credits" data-reveal style="--reveal-delay: .1s">
                  <p class="work-aside__label">CREDITS</p>
                  {work.data.credits.map((credit) => (
                    <div>
                      <span>{credit.role}</span>
                      <strong>{credit.name}</strong>
                    </div>
                  ))}
                </div>
              )}

              {isNovel && (
                <div class="work-progress" data-reveal style="--reveal-delay: .12s">
                  <p class="work-aside__label">READING PROGRESS</p>
                  <div class="work-progress__row">
                    <span class="work-progress__line"><span></span></span>
                    <strong data-reading-percent>0%</strong>
                  </div>
                </div>
              )}

              {isNovel && chapters.length > 0 && (
                <nav class="work-toc" aria-label="章节导航" data-reveal style="--reveal-delay: .16s">
                  <p class="work-aside__label">CHAPTERS</p>
                  {chapters.map((chapter, index) => (
                    <a href={`#${chapter.slug}`}>
                      <span>{String(index + 1).padStart(2, '0')}</span>
                      <span>{chapter.text}</span>
                    </a>
                  ))}
                </nav>
              )}

              <a class="work-back-link" href="/works/" data-nav-link data-reveal style="--reveal-delay: .18s">
                <Icon name="arrowLeft" size={13} />
                <span>返回全部作品</span>
              </a>
            </div>
          </aside>

          <div class="work-main">
            {isVideo && work.data.video && (
              <div class="work-player" data-reveal>
                <div class="work-player__head">
                  <span class="work-player__label"><i></i> SCREENING / 放映</span>
                  <button
                    type="button"
                    class="work-player__theater"
                    data-open-video
                    data-video-src={work.data.video}
                    data-video-poster={work.data.cover}
                  >
                    剧场模式 <Icon name="arrowUpRight" size={12} />
                  </button>
                </div>
                <div class="work-player__frame">
                  <video
                    controls
                    playsinline
                    preload="metadata"
                    poster={work.data.cover}
                    aria-label={`${work.data.title} 概念短片`}
                  >
                    <source src={work.data.video} type="video/mp4" />
                    <p>你的浏览器不支持视频播放。</p>
                  </video>
                </div>
                <div class="work-player__meta">
                  <span>{work.data.title} / {work.data.english}</span>
                  <span>{work.data.duration} · 无声影像</span>
                </div>
              </div>
            )}

            <div class:list={['prose', { 'prose--novel': isNovel, 'prose--work': !isNovel }]} data-article data-reveal="fade">
              <Content />
            </div>

            {work.data.gallery.length > 0 && (
              <section class="work-gallery" aria-labelledby="gallery-title">
                <div class="work-gallery__head" data-reveal>
                  <div>
                    <p class="eyebrow">VISUAL NOTES / 05</p>
                    <h2 class="work-gallery__title" id="gallery-title">{isNovel ? '内页插图' : isVideo ? '影像截帧' : '画面细节'}</h2>
                  </div>
                  <span class="work-gallery__hint">点击放大 / CLICK TO ZOOM</span>
                </div>

                <div class="work-gallery__grid" data-lightbox-group data-reveal>
                  {work.data.gallery.map((item, index) => (
                    <button
                      class="work-gallery__item"
                      type="button"
                      data-lightbox-item
                      data-src={item.src}
                      data-alt={item.alt}
                      data-caption={item.caption || item.alt}
                      data-cursor-label="Zoom"
                      aria-label={`放大查看：${item.alt}`}
                    >
                      <span class="work-gallery__media">
                        <img src={item.src} alt={item.alt} loading="lazy" width="1600" height="1200" />
                        <span class="work-gallery__overlay">
                          <span class="work-gallery__count">{String(index + 1).padStart(2, '0')}</span>
                          <span class="work-gallery__zoom"><Icon name="plus" size={16} /></span>
                        </span>
                      </span>
                      <span class="work-gallery__caption">{item.caption || item.alt}</span>
                    </button>
                  ))}
                </div>
              </section>
            )}

            <div class="work-end" data-reveal>
              <span class="work-end__line"></span>
              <span>END OF WORK · N° {work.data.serial}</span>
              <span class="work-end__line"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="next-work" aria-labelledby="next-work-title">
      <a class="next-work__link" href={`/works/${next.id}/`} data-nav-link data-cursor-label="Next">
        <span class="next-work__bg" aria-hidden="true">
          <img src={next.data.cover} alt="" loading="lazy" />
        </span>
        <span class="next-work__inner container">
          <span class="next-work__kicker">
            <span class="eyebrow">NEXT WORK / 下一件作品</span>
            <span>N° {next.data.serial}</span>
          </span>
          <span class="next-work__row">
            <span class="next-work__copy">
              <span class="next-work__category">{typeMeta[next.data.type].label} · {next.data.year}</span>
              <span class="next-work__title" id="next-work-title">{next.data.title}</span>
              <span class="next-work__en">{next.data.english}</span>
            </span>
            <span class="next-work__arrow">
              <Icon name="arrowRight" size={28} />
            </span>
          </span>
        </span>
      </a>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .reading-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 960;
    height: 2px;
    background: rgba(243, 238, 227, 0.08);
  }

  .reading-bar span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  .work {
    --work-accent: var(--accent);
  }

  .work-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + clamp(28px, 4vw, 56px));
    padding-bottom: clamp(70px, 8vw, 130px);
    border-bottom: 1px solid var(--line);
  }

  .work-hero__particles {
    inset: 0;
    z-index: 1;
  }

  .work-hero__ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .work-hero__ambient img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.1);
    transform: scale(1.12);
    opacity: 0.14;
  }

  .work-hero__ambient span {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 70% 35%, color-mix(in srgb, var(--work-accent) 12%, transparent), transparent 70%),
      linear-gradient(180deg, rgba(6, 7, 12, 0.62), rgba(6, 7, 12, 0.88) 65%, #07080d);
  }

  .work-hero__ambient::after {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/art/starfield.svg") center / cover no-repeat;
    opacity: 0.35;
  }

  .work-crumb {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
  }

  .work-crumb__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-dim);
    transition: color 0.35s ease;
  }

  .work-crumb__back:hover {
    color: var(--ink);
  }

  .work-crumb__meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .work-crumb__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--work-accent);
  }

  .work-hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(42px, 7vw, 120px);
    align-items: center;
    padding-top: clamp(44px, 7vw, 100px);
  }

  .work-hero__title {
    margin-top: 22px;
    font-family: var(--serif);
    font-size: clamp(44px, 5.6vw, 92px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .work-hero__english {
    margin-top: 14px;
    font-family: var(--display);
    font-size: clamp(19px, 1.8vw, 28px);
    font-style: italic;
    letter-spacing: 0.02em;
    color: var(--work-accent);
  }

  .work-hero__summary {
    max-width: 34em;
    margin-top: clamp(22px, 3vw, 34px);
    font-size: 14px;
    line-height: 2;
    color: var(--ink-dim);
  }

  .work-hero__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: clamp(30px, 4vw, 50px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .work-hero__facts div {
    display: grid;
    gap: 6px;
  }

  .work-hero__facts span {
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
  }

  .work-hero__facts strong {
    font-family: var(--serif);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
  }

  .work-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .work-hero__tags span {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
  }

  .work-hero__visual {
    position: relative;
    perspective: 1400px;
    justify-self: center;
    width: min(100%, 440px);
  }

  .work-hero__cover-tilt {
    transform: rotateX(var(--rx, 0deg)) rotateY(calc(var(--ry, 0deg) + 3deg)) rotate(1.5deg);
    transform-style: preserve-3d;
    transition: transform 0.55s var(--ease);
  }

  .work-hero__cover-tilt.is-tilting {
    transition-duration: 0.15s;
  }

  .work-cover {
    position: relative;
    padding: 8px;
    background: rgba(15, 18, 26, 0.82);
    border: 1px solid rgba(243, 238, 227, 0.18);
    box-shadow:
      0 48px 110px rgba(0, 0, 0, 0.58),
      0 0 80px color-mix(in srgb, var(--work-accent) 9%, transparent);
    overflow: hidden;
  }

  .work-cover--portrait {
    aspect-ratio: 4 / 5;
  }
  .work-cover--book {
    aspect-ratio: 3 / 4;
  }
  .work-cover--landscape {
    aspect-ratio: 16 / 10;
  }

  .work-cover > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease);
  }

  .work-hero__cover-tilt:hover .work-cover > img {
    transform: scale(1.035);
  }

  .work-cover__shade {
    position: absolute;
    inset: 8px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 55%, rgba(0, 0, 0, 0.44));
    pointer-events: none;
  }

  .work-cover__serial {
    position: absolute;
    left: 20px;
    bottom: 18px;
    font-family: var(--display);
    font-size: 13px;
    font-style: italic;
    color: rgba(255, 253, 248, 0.7);
  }

  .work-cover__label {
    position: absolute;
    right: 20px;
    top: 18px;
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    color: rgba(255, 253, 248, 0.5);
  }

  .work-cover__play {
    position: absolute;
    inset: 8px;
    display: grid;
    place-items: center;
    z-index: 2;
    cursor: pointer;
  }

  .work-cover__play-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 118px;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    color: rgba(255, 253, 248, 0.64);
  }

  .work-cover__play-ring svg {
    width: 100%;
    height: 100%;
    animation: spin 24s linear infinite;
  }

  .work-cover__play-ring text {
    font-family: var(--mono);
    font-size: 8.2px;
    letter-spacing: 0.2em;
    fill: currentColor;
  }

  .work-cover__play-center {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--white);
    color: #0c0c12;
    transition: background 0.35s ease, transform 0.45s var(--ease);
  }

  .work-cover__play-center svg {
    margin-left: 3px;
  }

  .work-cover__play:hover .work-cover__play-center {
    background: var(--accent);
    transform: scale(1.08);
  }

  .work-hero__vertical {
    position: absolute;
    top: 5%;
    right: -45px;
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.24em;
    writing-mode: vertical-rl;
    color: var(--ink-faint);
  }

  /* ---------------- Content ---------------- */
  .work-content {
    position: relative;
    padding-block: clamp(70px, 9vw, 140px);
    background:
      radial-gradient(ellipse 40% 45% at 90% 12%, color-mix(in srgb, var(--work-accent) 5%, transparent), transparent 70%),
      var(--bg);
  }

  .work-content--paper {
    background:
      radial-gradient(rgba(23, 22, 16, 0.14) 0.6px, transparent 0.6px),
      var(--paper);
    background-size: 6px 6px, auto;
    color: var(--paper-ink);
    border-block: 1px solid rgba(23, 22, 16, 0.16);
  }

  .work-content__grid {
    display: grid;
    grid-template-columns: minmax(190px, 260px) minmax(0, 1fr);
    gap: clamp(44px, 7vw, 120px);
    align-items: start;
  }

  .work-aside {
    align-self: stretch;
  }

  .work-aside__sticky {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
  }

  .work-info {
    display: grid;
    gap: 0;
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }

  .work-content--paper .work-info {
    border-color: rgba(23, 22, 16, 0.16);
  }

  .work-info div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }

  .work-content--paper .work-info div {
    border-color: rgba(23, 22, 16, 0.13);
  }

  .work-info dt {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .work-content--paper .work-info dt {
    color: var(--paper-dim);
  }

  .work-info dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 12px;
    text-align: right;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
  }

  .work-content--paper .work-info dd {
    color: var(--paper-ink);
  }

  .work-aside__label {
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
  }

  .work-content--paper .work-aside__label {
    color: var(--paper-dim);
  }

  .work-credits {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .work-content--paper .work-credits {
    border-color: rgba(23, 22, 16, 0.16);
  }

  .work-credits div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 0;
    font-size: 11px;
  }

  .work-credits span {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .work-content--paper .work-credits span {
