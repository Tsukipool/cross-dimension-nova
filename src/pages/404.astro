---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ParticleField from '../components/ParticleField.astro';
---

<BaseLayout title="迷失的次元" description="你进入了一个还没有被命名的次元。" page="not-found" noIndex>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__bg" aria-hidden="true">
      <ParticleField variant="starfield" density={0.68} accent="#ff93a6" opacity={0.7} />
      <span class="not-found__code">404</span>
      <span class="not-found__orbit not-found__orbit--one"></span>
      <span class="not-found__orbit not-found__orbit--two"></span>
      <span class="not-found__star not-found__star--one">✦</span>
      <span class="not-found__star not-found__star--two">✦</span>
      <span class="not-found__glow"></span>
    </div>

    <div class="container">
      <div class="not-found__inner">
        <p class="eyebrow" data-reveal>LOST IN DIMENSION / 404</p>
        <p class="not-found__jp" aria-hidden="true" data-reveal style="--reveal-delay: .06s">ここには、まだ何もない。</p>

        <h1 class="not-found__title" id="not-found-title">
          <span class="line-mask" style="--line-delay: .08s"><span>这个次元</span></span>
          <span class="line-mask" style="--line-delay: .16s"><span>还没有被<em>命名</em>。</span></span>
        </h1>

        <p class="not-found__text" data-reveal style="--reveal-delay: .22s">
          你偏移了大约 0.00001 个次元单位。别担心，回到我们熟悉的地方就好。
        </p>

        <div class="not-found__actions" data-reveal style="--reveal-delay: .28s">
          <a class="btn btn--ghost" href="/" data-nav-link data-magnetic>
            <span>回到首页</span>
            <span class="btn__dot"><Icon name="arrowUpRight" size={14} /></span>
          </a>
          <a class="text-link" href="/works/" data-nav-link>
            <span class="text-link__line">浏览作品档案</span>
            <Icon name="arrowRight" size={13} />
          </a>
        </div>

        <div class="not-found__meta" data-reveal style="--reveal-delay: .34s">
          <span>COORDINATES 36.65°N / 117.12°E</span>
          <span>SIGNAL LOST · RETRY?</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding-top: var(--nav-h);
    padding-bottom: 80px;
    background:
      radial-gradient(ellipse 55% 55% at 50% 48%, rgba(92, 55, 78, 0.17), transparent 70%),
      var(--bg);
  }

  .not-found__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .not-found__code {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--display);
    font-size: clamp(280px, 52vw, 820px);
    font-style: italic;
    font-weight: 500;
    line-height: 0.7;
    color: transparent;
    -webkit-text-stroke: 1px rgba(243, 238, 227, 0.055);
    user-select: none;
  }

  .not-found__orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(70vw, 1000px);
    aspect-ratio: 1;
    border: 1px solid rgba(243, 238, 227, 0.08);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotateX(70deg);
  }

  .not-found__orbit--one {
    border-color: rgba(255, 147, 166, 0.16);
    animation: lost-orbit 32s linear infinite;
  }

  .not-found__orbit--two {
    width: min(46vw, 650px);
    border-style: dashed;
    animation: lost-orbit 48s linear infinite reverse;
  }

  @keyframes lost-orbit {
    from { transform: translate(-50%, -50%) rotateX(70deg) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotateX(70deg) rotate(360deg); }
  }

  .not-found__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40vw;
    height: 40vw;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 147, 166, 0.11), transparent 66%);
  }

  .not-found__star {
    position: absolute;
    color: var(--accent);
    animation: float 8s ease-in-out infinite;
  }
  .not-found__star--one {
    top: 24%;
    left: 18%;
    font-size: 18px;
  }
  .not-found__star--two {
    right: 20%;
    bottom: 26%;
    font-size: 26px;
    color: var(--accent-warm);
    animation-delay: -3s;
  }

  .not-found .container {
    position: relative;
    z-index: 1;
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .not-found__jp {
    margin-top: 24px;
    font-family: var(--serif);
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--ink-faint);
  }

  .not-found__title {
    margin-top: clamp(28px, 4vw, 46px);
    font-family: var(--serif);
    font-size: clamp(42px, 6.4vw, 100px);
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.045em;
  }

  .not-found__title em {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.1em;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .not-found__text {
    max-width: 32em;
    margin-top: 26px;
    font-size: 13px;
    line-height: 2;
    color: var(--ink-dim);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 28px;
    margin-top: clamp(32px, 4vw, 50px);
  }

  .not-found__meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    width: min(100%, 620px);
    margin-top: clamp(60px, 9vw, 120px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
  }

  @media (max-width: 600px) {
    .not-found__meta {
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
    .not-found__actions {
      flex-direction: column;
      width: 100%;
    }
    .not-found__actions .btn {
      width: 100%;
    }
    .not-found__orbit {
      width: 110vw;
    }
    .not-found__orbit--two {
      width: 80vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__orbit,
    .not-found__star {
      animation: none !important;
    }
  }
</style>
