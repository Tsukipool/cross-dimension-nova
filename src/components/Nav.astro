---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const onWorks = path.startsWith('/works');
const onAbout = path.startsWith('/about');
const onHome = path === '/';

const links = [
  { href: '/works/', label: '作品档案', en: 'ARCHIVE', no: '01', active: onWorks },
  { href: '/about/', label: '关于社团', en: 'ABOUT', no: '02', active: onAbout },
  { href: '/#cinema', label: '放映室', en: 'SCREENING', no: '03', active: false },
  { href: '/#join', label: '加入我们', en: 'JOIN', no: '04', active: false },
];
---

<header class="site-nav" data-nav data-on-home={onHome ? 'true' : 'false'}>
  <div class="site-nav__inner">
    <Logo />

    <nav class="site-nav__links" aria-label="主导航">
      {links.slice(0, 3).map((link) => (
        <a
          class:list={['site-nav__link', { 'is-active': link.active }]}
          href={link.href}
          data-nav-link
          aria-current={link.active ? 'page' : undefined}
        >
          <span class="site-nav__num">{link.no}</span>
          <span class="site-nav__label">{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="site-nav__actions">
      <a class="site-nav__cta" href="/#join" data-nav-link data-magnetic>
        <span class="site-nav__cta-dot"></span>
        <span>加入我们</span>
        <Icon name="arrowUpRight" size={13} />
      </a>
      <button
        class="site-nav__burger"
        type="button"
        aria-label="打开菜单"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="site-nav__burger-label" data-menu-label>MENU</span>
        <span class="site-nav__burger-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
  <div class="site-nav__progress" aria-hidden="true"><span data-scroll-progress></span></div>
</header>

<div class="site-menu" id="site-menu" data-menu aria-hidden="true">
  <div class="site-menu__inner container--wide">
    <div class="site-menu__main">
      <p class="eyebrow site-menu__eyebrow">INDEX / 目录</p>
      <nav class="site-menu__links" aria-label="全站导航">
        {links.map((link) => (
          <a href={link.href} data-menu-link data-nav-link>
            <span class="site-menu__no">{link.no}</span>
            <span class="site-menu__label">{link.label}</span>
            <span class="site-menu__en">{link.en}</span>
            <Icon name="arrowUpRight" size={22} class="site-menu__arrow" />
          </a>
        ))}
      </nav>
      <div class="site-menu__meta">
        <p>山东省济钢高级中学（全福校区） · 跨次元新星动漫社</p>
        <p>EST. 2026 / JINAN, CHINA</p>
      </div>
    </div>

    <div class="site-menu__visual" aria-hidden="true">
      <div class="site-menu__card site-menu__card--one">
        <img src="/art/moonlit-tea-party.svg" alt="" loading="lazy" />
      </div>
      <div class="site-menu__card site-menu__card--two">
        <img src="/art/stardust-tram.svg" alt="" loading="lazy" />
      </div>
      <div class="site-menu__card site-menu__card--three">
        <img src="/art/first-night-screening.svg" alt="" loading="lazy" />
      </div>
      <p class="site-menu__vertical">まだ見ぬ次元の向こうへ</p>
      <span class="site-menu__star">✦</span>
    </div>
  </div>
</div>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 900;
    transition: background 0.5s var(--ease), backdrop-filter 0.5s var(--ease), border-color 0.5s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-nav::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 8, 13, 0.78), rgba(7, 8, 13, 0));
    opacity: 1;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }

  .site-nav.is-scrolled {
    background: rgba(7, 8, 13, 0.72);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    border-bottom-color: var(--line);
  }
  .site-nav.is-scrolled::before {
    opacity: 0;
  }

  .site-nav__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - var(--gutter) * 2, var(--max));
    height: var(--nav-h);
    margin-inline: auto;
  }

  .site-nav__links {
    position: absolute;
    left: 50%;
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 46px);
    transform: translateX(-50%);
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding-block: 8px;
    color: var(--ink-dim);
    font-size: 12px;
    letter-spacing: 0.12em;
    transition: color 0.35s ease;
  }

  .site-nav__num {
    font-family: var(--display);
    font-size: 9px;
    color: var(--ink-faint);
    transition: color 0.35s ease;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--ink);
  }
  .site-nav__link:hover .site-nav__num,
  .site-nav__link.is-active .site-nav__num {
    color: var(--accent);
  }
  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 42px;
    padding: 0 17px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 0.14em;
    transition: background 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .site-nav__cta:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .site-nav__cta-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px rgba(255, 147, 166, 0.85);
  }

  .site-nav__burger {
    display: none;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }

  .site-nav__burger-label {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--ink-dim);
  }

  .site-nav__burger-icon {
    position: relative;
    display: grid;
    place-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background 0.35s ease, border-color 0.35s ease;
  }

  .site-nav__burger-icon span {
    display: block;
    width: 14px;
    height: 1px;
    background: currentColor;
    transition: transform 0.45s var(--ease);
  }

  .site-nav__burger:hover .site-nav__burger-icon {
    background: rgba(243, 238, 227, 0.08);
  }

  .site-nav.is-menu-open .site-nav__burger-icon span:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .site-nav.is-menu-open .site-nav__burger-icon span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .site-nav__progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: transparent;
    overflow: hidden;
  }
  .site-nav__progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-deep), var(--accent), var(--accent-warm));
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  /* ---------------- Full-screen menu ---------------- */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 850;
    background: var(--bg-deep);
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.85s var(--ease-io), visibility 0s linear 0.85s;
    overflow: hidden;
  }

  .site-menu.is-open {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.85s var(--ease-io), visibility 0s linear 0s;
  }

  .site-menu::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 60% at 80% 35%, rgba(125, 72, 112, 0.22), transparent 70%),
      radial-gradient(ellipse 50% 50% at 10% 90%, rgba(35, 79, 89, 0.18), transparent 70%);
    pointer-events: none;
  }

  .site-menu__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 7vw;
    height: 100%;
    padding-top: calc(var(--nav-h) + 5vh);
    padding-bottom: 6vh;
  }

  .site-menu__main {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .site-menu__eyebrow {
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease 0.35s, transform 0.8s var(--ease) 0.35s;
  }

  .site-menu.is-open .site-menu__eyebrow {
    opacity: 1;
    transform: none;
  }

  .site-menu__links {
    border-top: 1px solid var(--line);
  }

  .site-menu__links a {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr auto 30px;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    padding: clamp(13px, 1.8vw, 22px) 0;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    transition: padding 0.5s var(--ease);
  }

  .site-menu__links a::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255, 147, 166, 0.08), transparent 70%);
    transform: translateX(-100%);
    transition: transform 0.6s var(--ease);
  }
  .site-menu__links a:hover::before {
    transform: translateX(0);
  }
  .site-menu__links a:hover {
    padding-left: 18px;
  }

  .site-menu__no {
    font-family: var(--display);
    font-size: clamp(13px, 1.1vw, 17px);
    font-style: italic;
    color: var(--accent);
  }

  .site-menu__label {
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 74px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .site-menu__en {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    color: var(--ink-faint);
  }

  .site-menu__arrow {
    color: var(--ink-faint);
    transition: transform 0.5s var(--ease), color 0.4s ease;
  }
  .site-menu__links a:hover .site-menu__arrow {
    transform: translate(4px, -4px);
    color: var(--ink);
  }

  .site-menu__links a {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.55s ease,
      transform 0.7s var(--ease),
      padding 0.5s var(--ease);
  }
  .site-menu.is-open .site-menu__links a {
    opacity: 1;
    transform: none;
  }
  .site-menu.is-open .site-menu__links a:nth-child(1) { transition-delay: 0.32s; }
  .site-menu.is-open .site-menu__links a:nth-child(2) { transition-delay: 0.39s; }
  .site-menu.is-open .site-menu__links a:nth-child(3) { transition-delay: 0.46s; }
  .site-menu.is-open .site-menu__links a:nth-child(4) { transition-delay: 0.53s; }

  .site-menu__meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(28px, 4vh, 54px);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    opacity: 0;
    transition: opacity 0.6s ease 0.65s;
  }
  .site-menu.is-open .site-menu__meta {
    opacity: 1;
  }

  .site-menu__visual {
    position: relative;
    align-self: center;
    height: min(66vh, 660px);
    perspective: 1200px;
  }

  .site-menu__card {
    position: absolute;
    overflow: hidden;
    border-radius: var(--radius-sm);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(50px) rotate(var(--rot, 0deg));
    transition: opacity 0.7s ease, transform 1.1s var(--ease);
  }
  .site-menu.is-open .site-menu__card {
    opacity: 1;
    transform: translateY(0) rotate(var(--rot, 0deg));
  }

  .site-menu__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-menu__card--one {
    top: 4%;
    left: 4%;
    width: 46%;
    aspect-ratio: 3 / 4;
    --rot: -5deg;
    transition-delay: 0.35s;
  }

  .site-menu__card--two {
    top: 25%;
    right: 2%;
    width: 44%;
    aspect-ratio: 4 / 5;
    --rot: 4deg;
    transition-delay: 0.45s;
  }

  .site-menu__card--three {
    bottom: 2%;
    left: 26%;
    width: 42%;
    aspect-ratio: 16 / 10;
    --rot: -2deg;
    transition-delay: 0.55s;
  }

  .site-menu__vertical {
    position: absolute;
    top: 8%;
    right: 8%;
    font-family: var(--serif);
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--ink-faint);
    writing-mode: vertical-rl;
    opacity: 0;
    transition: opacity 0.8s ease 0.7s;
  }
  .site-menu.is-open .site-menu__vertical {
    opacity: 1;
  }

  .site-menu__star {
    position: absolute;
    right: 38%;
    bottom: 8%;
    font-size: 22px;
    color: var(--accent);
    animation: spin 18s linear infinite;
  }

  @media (max-width: 1100px) {
    .site-nav__links {
      display: none;
    }
    .site-nav__burger {
      display: flex;
    }
    .site-nav__cta {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .site-menu__inner {
      grid-template-columns: 1fr;
      padding-top: calc(var(--nav-h) + 24px);
    }
    .site-menu__visual {
      display: none;
    }
    .site-menu__meta {
      flex-direction: column;
      gap: 8px;
    }
    .site-menu__links a {
      grid-template-columns: 36px 1fr 26px;
    }
    .site-menu__en {
      display: none;
    }
    .site-menu__label {
      font-size: clamp(34px, 10vw, 56px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu {
      transition: none;
    }
  }
</style>
