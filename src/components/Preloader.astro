---
import Icon from './Icon.astro';
---

<div class="preloader" data-preloader aria-hidden="true">
  <span class="preloader__corner preloader__corner--tl">CROSS-DIMENSION NOVA</span>
  <span class="preloader__corner preloader__corner--tr">EST. 2026</span>

  <div class="preloader__inner">
    <div class="preloader__mark" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none">
        <circle cx="32" cy="32" r="20" stroke="currentColor" stroke-opacity=".32" />
        <ellipse cx="32" cy="32" rx="29" ry="10" stroke="var(--accent)" stroke-opacity=".8" transform="rotate(-28 32 32)" />
        <path d="M32 15l3 13.9L49 32l-14 3.1L32 49l-3-13.9L15 32l14-3.1Z" fill="currentColor" />
        <circle cx="51" cy="20" r="2.5" fill="var(--accent)" />
      </svg>
    </div>
    <p class="preloader__name">跨次元新星</p>
    <p class="preloader__sub">PLEASE WAIT · 正在穿越次元</p>
    <div class="preloader__meter">
      <span class="preloader__bar" data-preloader-bar></span>
    </div>
  </div>

  <span class="preloader__count"><span data-preloader-count>00</span><i>/ 100</i></span>
  <span class="preloader__corner preloader__corner--bl">JINAN · SHANDONG</span>
  <span class="preloader__corner preloader__corner--br" aria-hidden="true">
    <Icon name="arrowDown" size={13} />
  </span>
</div>

<style>
  .preloader {
    background:
      radial-gradient(ellipse 45% 55% at 50% 50%, rgba(90, 54, 82, 0.14), transparent 70%),
      var(--bg-deep);
    overflow: hidden;
  }

  .preloader::before {
    content: "";
    position: absolute;
    inset: 24px;
    border: 1px solid rgba(243, 238, 227, 0.08);
    pointer-events: none;
  }

  .preloader__corner {
    position: absolute;
    z-index: 1;
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
  }
  .preloader__corner--tl { top: 40px; left: 40px; }
  .preloader__corner--tr { top: 40px; right: 40px; }
  .preloader__corner--bl { bottom: 40px; left: 40px; }
  .preloader__corner--br { bottom: 36px; right: 40px; color: var(--ink-dim); }

  .preloader__inner {
    position: relative;
    z-index: 1;
  }

  .preloader__mark {
    width: 58px;
    height: 58px;
    margin: 0 auto 28px;
  }

  .preloader__name {
    font-family: var(--serif);
    font-size: clamp(22px, 2.5vw, 30px);
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    text-align: center;
    color: var(--ink);
  }

  .preloader__sub {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.26em;
    text-align: center;
    color: var(--ink-faint);
  }

  .preloader__meter {
    width: min(250px, 52vw);
    margin: 32px auto 0;
  }

  .preloader__count {
    position: absolute;
    z-index: 1;
    right: 40px;
    bottom: 34px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--display);
    font-size: 42px;
    font-style: italic;
    line-height: 1;
    color: var(--ink);
  }

  .preloader__count i {
    font-family: var(--mono);
    font-size: 8px;
    font-style: normal;
    letter-spacing: 0.15em;
    color: var(--ink-faint);
  }

  @media (max-width: 600px) {
    .preloader::before {
      inset: 14px;
    }
    .preloader__corner--tl,
    .preloader__corner--tr,
    .preloader__corner--bl {
      display: none;
    }
    .preloader__count {
      right: 24px;
      bottom: 24px;
    }
    .preloader__corner--br {
      left: 24px;
      right: auto;
      bottom: 30px;
    }
  }
</style>
