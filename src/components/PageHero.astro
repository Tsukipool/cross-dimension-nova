---
import ParticleField from './ParticleField.astro';
import { withBase } from '../lib/url';

interface Props {
  eyebrow: string;
  title: string;
  english: string;
  lead: string;
  meta?: string;
  index?: string;
  image?: string;
  imageAlt?: string;
  accent?: string;
  particleAccent?: string;
}

const {
  eyebrow,
  title,
  english,
  lead,
  meta = 'EST. 2026 / JINAN',
  index = '✦',
  image,
  imageAlt = '',
  accent = 'var(--accent)',
  particleAccent = '#ff93a6',
} = Astro.props;
---

<section
  class:list={['page-hero', { 'page-hero--with-art': Boolean(image) }]}
  style={`--page-accent: ${accent}`}
  aria-labelledby="page-hero-title"
>
  <div class="page-hero__backdrop" aria-hidden="true">
    <ParticleField
      variant="dust"
      density={0.8}
      accent={particleAccent}
      opacity={0.62}
      class="page-hero__particles"
    />
    <span class="page-hero__word">{english}</span>
    <span class="page-hero__orbit page-hero__orbit--one"></span>
    <span class="page-hero__orbit page-hero__orbit--two"></span>
    <span class="page-hero__grid"></span>
    <span class="page-hero__glow"></span>
    <span class="page-hero__index">{index}</span>
    {
      image && (
        <div class="page-hero__art-tilt" data-tilt>
          <figure class="page-hero__art">
            <img src={withBase(image)} alt={imageAlt} width="1200" height="1500" loading="eager" />
            <figcaption>
              <span>{meta}</span>
              <span>✦</span>
            </figcaption>
          </figure>
        </div>
      )
    }
  </div>

  <div class="page-hero__inner container--wide">
    <div class="page-hero__top">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <p class="page-hero__meta" data-reveal style="--reveal-delay: .08s">{meta}</p>
    </div>

    <h1 class="page-hero__title" id="page-hero-title">
      <span class="line-mask" style="--line-delay: .05s"><span>{title}</span></span>
    </h1>

    <div class="page-hero__bottom">
      <p class="page-hero__lead" data-reveal style="--reveal-delay: .14s">{lead}</p>
      <div class="page-hero__aside" data-reveal style="--reveal-delay: .2s">
        <slot name="aside" />
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(560px, 72svh, 760px);
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--nav-h) + 8vh);
    padding-bottom: clamp(44px, 6vw, 84px);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 50% 60% at 76% 38%, color-mix(in srgb, var(--page-accent) 8%, transparent), transparent 70%),
      linear-gradient(180deg, #06070c, #090a12 65%, #07080d);
  }

  .page-hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-hero__particles {
    inset: 0;
  }

  .page-hero__backdrop::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--starfield-url) center / cover no-repeat;
    opacity: 0.3;
  }

  .page-hero__word {
    position: absolute;
    top: 20%;
    left: 0;
    font-family: var(--display);
    font-size: clamp(110px, 22vw, 380px);
    font-style: italic;
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(243, 238, 227, 0.06);
    transform: translateX(-2%);
    user-select: none;
  }

  .page-hero__orbit {
    position: absolute;
    top: 42%;
    right: 6%;
    width: min(50vw, 760px);
    aspect-ratio: 1;
    border: 1px solid rgba(243, 238, 227, 0.08);
    border-radius: 50%;
    transform: translateY(-50%) rotateX(68deg);
  }

  .page-hero__orbit--one {
    border-color: color-mix(in srgb, var(--page-accent) 22%, transparent);
    animation: page-orbit 28s linear infinite;
  }

  .page-hero__orbit--two {
    width: min(34vw, 540px);
    border-style: dashed;
    animation: page-orbit 44s linear infinite reverse;
  }

  @keyframes page-orbit {
    to { transform: translateY(-50%) rotateX(68deg) rotate(360deg); }
  }

  .page-hero__grid {
    position: absolute;
    left: -20%;
    right: -20%;
    bottom: -25%;
    height: 58vh;
    background-image:
      linear-gradient(rgba(243, 238, 227, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(243, 238, 227, 0.05) 1px, transparent 1px);
    background-size: 80px 80px;
    transform: perspective(600px) rotateX(66deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent 72%);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent 72%);
  }

  .page-hero__glow {
    position: absolute;
    right: 8%;
    top: 20%;
    width: 46vw;
    height: 46vw;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--page-accent) 13%, transparent), transparent 66%);
  }

  .page-hero__index {
    position: absolute;
    top: 12%;
    right: 5%;
    font-family: var(--display);
    font-size: clamp(60px, 9vw, 130px);
    font-style: italic;
    line-height: 1;
    color: rgba(243, 238, 227, 0.05);
  }

  .page-hero__art-tilt {
    position: absolute;
    top: 22%;
    right: 4.5%;
    width: clamp(170px, 19vw, 300px);
    opacity: 0.9;
    perspective: 1200px;
    transform:
      perspective(1200px)
      rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.55s var(--ease);
    pointer-events: auto;
    will-change: transform;
  }

  .page-hero__art-tilt.is-tilting {
    transition-duration: 0.15s;
  }

  .page-hero__art {
    position: relative;
    margin: 0;
    padding: 7px 7px 8px;
    background: rgba(15, 18, 26, 0.82);
    border: 1px solid rgba(243, 238, 227, 0.14);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
    transform: rotate(4.5deg);
    animation: page-art-float 10s ease-in-out infinite;
  }

  @keyframes page-art-float {
    0%, 100% { transform: rotate(4.5deg) translateY(0); }
    50% { transform: rotate(3.3deg) translateY(-12px); }
  }

  .page-hero__art img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.9);
  }

  .page-hero__art figcaption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding-top: 7px;
    font-family: var(--mono);
    font-size: 6px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .page-hero__art figcaption span:last-child {
    color: var(--page-accent);
  }

  .page-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: min(100% - var(--gutter) * 2, var(--max));
  }

  .page-hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .page-hero--with-art .page-hero__meta {
    visibility: hidden;
  }

  .page-hero__meta {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
  }

  .page-hero__title {
    position: relative;
    z-index: 1;
    margin-top: clamp(22px, 4vh, 44px);
    font-family: var(--serif);
    font-size: clamp(64px, 10.5vw, 168px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 68%;
  }

  .page-hero__title .line-mask {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .page-hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: end;
    gap: clamp(30px, 6vw, 110px);
    margin-top: clamp(40px, 7vh, 80px);
    padding-top: clamp(22px, 3vh, 34px);
    border-top: 1px solid var(--line);
  }

  .page-hero__lead {
    max-width: 36em;
    font-size: 13px;
    line-height: 2;
    color: var(--ink-dim);
  }

  .page-hero__aside {
    justify-self: end;
    text-align: right;
  }

  @media (max-width: 900px) {
    .page-hero {
      min-height: 62svh;
    }
    .page-hero__art-tilt {
      top: 18%;
      right: 3%;
      width: 22vw;
      opacity: 0.5;
    }
    .page-hero__title {
      max-width: 100%;
    }
    .page-hero__word {
      top: 26%;
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      min-height: 56svh;
      padding-bottom: 32px;
    }
    .page-hero__art-tilt {
      display: none;
    }
    .page-hero__title {
      font-size: clamp(54px, 16vw, 88px);
      margin-top: 18px;
    }
    .page-hero__bottom {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 34px;
    }
    .page-hero__aside {
      justify-self: start;
      text-align: left;
    }
    .page-hero__word {
      top: 30%;
    }
    .page-hero__meta {
      font-size: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__orbit,
    .page-hero__art {
      animation: none;
    }
    .page-hero__art-tilt {
      transform: none;
    }
  }
</style>
