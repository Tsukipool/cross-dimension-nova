---
import Icon from './Icon.astro';
---

<dialog class="video-modal" data-video-modal aria-label="视频播放器">
  <div class="video-modal__inner">
    <button class="video-modal__close" type="button" data-video-close>
      <span>关闭</span>
      <Icon name="close" size={14} />
    </button>
    <video data-video-player controls playsinline preload="metadata"></video>
  </div>
</dialog>

<style>
  .video-modal__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 253, 248, 0.22);
    border-radius: 999px;
    background: rgba(5, 6, 10, 0.62);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: rgba(255, 253, 248, 0.82);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.14em;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .video-modal__close:hover {
    background: var(--ink);
    color: var(--bg);
  }

  @media (max-width: 600px) {
    .video-modal__close span {
      display: none;
    }
    .video-modal__close {
      padding: 8px;
    }
  }
</style>
