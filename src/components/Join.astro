---
import Icon from './Icon.astro';
import ParticleField from './ParticleField.astro';
---

<section class="join section" id="join" aria-labelledby="join-title">
  <div class="join__backdrop" aria-hidden="true">
    <ParticleField variant="dust" density={0.9} accent="#ff93a6" opacity={0.58} class="join__particles" />
    <span class="join__bgtext">NEXT DIMENSION</span>
    <span class="join__orbit join__orbit--one"></span>
    <span class="join__orbit join__orbit--two"></span>
    <span class="join__orbit join__orbit--three"></span>
    <span class="join__star join__star--one">✦</span>
    <span class="join__star join__star--two">✦</span>
    <span class="join__glow"></span>
  </div>

  <div class="container">
    <div class="join__inner">
      <p class="eyebrow" data-reveal>JOIN THE DIMENSION / 05</p>

      <h2 class="join__title" id="join-title" data-reveal style="--reveal-delay: .08s">
        下一次相遇，<br />
        <span class="line-mask" style="--line-delay: .18s"><span><em>在画格之间。</em></span></span>
      </h2>

      <p class="join__lead" data-reveal style="--reveal-delay: .16s">
        无论你画画、写故事、剪片子，还是只想安静地看一场动画——这里都留着一个位置。我们尊重每一种喜欢的方式。
      </p>

      <div class="join__actions" data-reveal style="--reveal-delay: .22s">
        <a class="btn btn--ghost" href="/about/" data-nav-link data-magnetic>
          <span>了解社团与加入方式</span>
          <span class="btn__dot"><Icon name="arrowUpRight" size={14} /></span>
        </a>
        <a class="text-link" href="/works/" data-nav-link>
          <span class="text-link__line">先看看我们的作品</span>
          <Icon name="arrowRight" size={13} />
        </a>
      </div>

      <p class="join__note" data-reveal style="--reveal-delay: .28s">
        <span class="join__note-dot"></span>
        招新与活动信息以校内公告为准 · 期待与你相遇
      </p>
    </div>

    <div class="join__ring" aria-hidden="true">
      <svg viewBox="0 0 160 160">
        <defs>
          <path id="join-ring-path" d="M80,80 m-64,0 a64,64 0 1,1 128,0 a64,64 0 1,1 -128,0" />
        </defs>
        <text>
          <textPath href="#join-ring-path">CROSS-DIMENSION NOVA · RECRUITING · 跨次元新星 · 招新中 · </textPath>
        </text>
      </svg>
      <span class="join__ring-center">✦</span>
    </div>
  </div>
</section>

<style>
  .join {
    position: relative;
    min-height: 88svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 50% 60% at 50% 55%, rgba(97, 55, 79, 0.22), transparent 70%),
      linear-gradient(180deg, #06070c, #080910 50%, #05060a);
  }

  .join__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    perspective: 1000px;
  }

  .join__backdrop::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/art/starfield.svg") center / cover no-repeat;
    opacity: 0.36;
  }

  .join__bgtext {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--display);
    font-size: clamp(90px, 18vw, 320px);
    font-weight: 500;
    line-height: 0.8;
    font-style: italic;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(243, 238, 227, 0.055);
    letter-spacing: -0.02em;
    user-select: none;
  }

  .join__orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgba(243, 238, 227, 0.1);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotateX(68deg);
  }

  .join__orbit--one {
    width: 64vw;
    height: 64vw;
    border-color: rgba(255, 147, 166, 0.15);
    animation: join-orbit 28s linear infinite;
  }
  .join__orbit--two {
    width: 86vw;
    height: 86vw;
    border-style: dashed;
    animation: join-orbit 46s linear infinite reverse;
  }
  .join__orbit--three {
    width: 44vw;
    height: 44vw;
    border-color: rgba(143, 222, 217, 0.12);
    animation: join-orbit 20s linear infinite;
  }

  @keyframes join-orbit {
    from { transform: translate(-50%, -50%) rotateX(68deg) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotateX(68deg) rotate(360deg); }
  }

  .join__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48vw;
    height: 48vw;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 147, 166, 0.1), transparent 64%);
  }

  .join__star {
    position: absolute;
    color: var(--accent);
    animation: join-twinkle 3.4s ease-in-out infinite alternate;
  }

  @keyframes join-twinkle {
    from { opacity: 0.25; transform: scale(0.8) rotate(0deg); }
    to { opacity: 1; transform: scale(1.15) rotate(20deg); }
  }
  .join__star--one {
    top: 20%;
    left: 14%;
    font-size: 18px;
  }
  .join__star--two {
    right: 16%;
    bottom: 22%;
    font-size: 26px;
    animation-delay: -1.4s;
    color: var(--accent-warm);
  }

  .join > .container {
    position: relative;
    z-index: 1;
  }

  .join__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 980px;
    margin-inline: auto;
    text-align: center;
  }

  .join__title {
    margin-top: clamp(28px, 4vw, 44px);
    font-family: var(--serif);
    font-size: clamp(44px, 7vw, 110px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.045em;
  }

  .join__title em {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.12em;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .join__lead {
    max-width: 36em;
    margin-top: clamp(28px, 3.5vw, 44px);
    font-size: 14px;
    line-height: 2.05;
    color: var(--ink-dim);
  }

  .join__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(22px, 3vw, 40px);
    margin-top: clamp(34px, 4.5vw, 54px);
  }

  .join__note {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: clamp(34px, 4vw, 50px);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .join__note-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent-warm);
  }

  .join__ring {
    position: absolute;
    right: 0;
    bottom: -13%;
    width: clamp(100px, 12vw, 160px);
    aspect-ratio: 1;
    color: var(--ink-faint);
    opacity: 0.8;
  }

  .join__ring svg {
    width: 100%;
    height: 100%;
    animation: spin 34s linear infinite;
  }

  .join__ring text {
    font-family: var(--mono);
    font-size: 8.4px;
    letter-spacing: 0.22em;
    fill: currentColor;
  }

  .join__ring-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--accent);
    font-size: 20px;
  }

  @media (max-width: 900px) {
    .join {
      min-height: 80svh;
    }
    .join__ring {
      right: 4%;
      bottom: 4%;
      opacity: 0.5;
    }
  }

  @media (max-width: 600px) {
    .join__title {
      line-height: 1.25;
    }
    .join__actions {
      flex-direction: column;
      width: 100%;
    }
    .join__actions .btn {
      width: 100%;
    }
    .join__lead {
      font-size: 13px;
    }
    .join__ring {
      display: none;
    }
    .join__bgtext {
      font-size: 26vw;
      transform: translate(-50%, -50%) rotate(-90deg);
    }
    .join__lead br {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .join__orbit,
    .join__star,
    .join__ring svg {
      animation: none !important;
    }
  }
</style>
