---
interface Props {
  variant?: 'starfield' | 'dust';
  density?: number;
  accent?: string;
  opacity?: number;
  class?: string;
}

const {
  variant = 'dust',
  density = 1,
  accent = '#ff93a6',
  opacity = 1,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['particle-field', `particle-field--${variant}`, className]}
  data-particle-field
  data-variant={variant}
  data-density={density}
  style={`--particle-accent: ${accent}; --particle-opacity: ${opacity};`}
  aria-hidden="true"
>
  <canvas data-particle-canvas></canvas>
</div>

<style>
  .particle-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--particle-opacity, 1);
    contain: layout paint style;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
