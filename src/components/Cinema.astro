---
import type { Work } from '../lib/works';
import { workHref } from '../lib/works';
import Icon from './Icon.astro';

interface Props {
  videos: Work[];
}

const { videos } = Astro.props;
const [mainFilm, secondFilm] = videos;
---

{
  mainFilm && (
    <section class="cinema section" id="cinema" aria-labelledby="cinema-title">
      <div class="cinema__wash" aria-hidden="true"></div>
      <div class="container">
        <header class="section-head cinema__head">
          <div>
            <p class="eyebrow" data-reveal>SCREENING ROOM / 03</p>
            <h2 class="section-head__title" id="cinema-title" data-reveal style="--reveal-delay: .08s">
              光落下时，<em>故事开始</em>
            </h2>
          </div>
          <div class="section-head__aside" data-reveal style="--reveal-delay: .16s">
            <p>当声音退场，画面开始呼吸。这里是社团的放映室，收藏我们关于动态影像的第一次实验。</p>
          </div>
        </header>

        <div class="cinema__stage">
          <div class="cinema__main" data-reveal="scale">
            <button
              class="cinema__poster"
              type="button"
              data-open-video
              data-video-src={mainFilm.data.video}
              data-video-poster={mainFilm.data.cover}
              data-cursor-label="Play"
              aria-label={`播放短片：${mainFilm.data.title}`}
            >
              <img src={mainFilm.data.cover} alt={mainFilm.data.title} loading="lazy" width="1920" height="1080" />
              <span class="cinema__poster-shade"></span>
              <span class="cinema__scan"></span>
              <span class="cinema__film-edge cinema__film-edge--top" aria-hidden="true"></span>
              <span class="cinema__film-edge cinema__film-edge--bottom" aria-hidden="true"></span>

              <span class="cinema__poster-top">
                <span class="cinema__rec"><i></i> CXN FILM</span>
                <span>{mainFilm.data.date} / {mainFilm.data.duration}</span>
              </span>

              <span class="cinema__play">
                <span class="cinema__play-ring">
                  <svg viewBox="0 0 120 120" aria-hidden="true">
                    <defs>
                      <path id="cinema-play-path" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0" />
                    </defs>
                    <text>
                      <textPath href="#cinema-play-path">PLAY THE FILM · CROSS-DIMENSION NOVA · </textPath>
                    </text>
                  </svg>
                </span>
                <span class="cinema__play-center"><Icon name="play" size={26} /></span>
              </span>

              <span class="cinema__poster-info">
                <span class="cinema__poster-category">{mainFilm.data.category} / N° {mainFilm.data.serial}</span>
                <span class="cinema__poster-title">{mainFilm.data.title}</span>
                <span class="cinema__poster-en">{mainFilm.data.english}</span>
              </span>
            </button>
          </div>

          <aside class="cinema__aside">
            <div data-reveal="right">
              <p class="cinema__aside-quote">
                关掉灯，<br />让画面自己说话。
              </p>
              <p class="cinema__aside-text">
                {mainFilm.data.summary}
              </p>
              <div class="cinema__meta-list">
                <div><span>FORMAT</span><strong>CONCEPT FILM</strong></div>
                <div><span>DURATION</span><strong>{mainFilm.data.duration}</strong></div>
                <div><span>SOUND</span><strong>SILENT / LOOP</strong></div>
              </div>
              <a class="text-link cinema__detail-link" href={workHref(mainFilm)} data-nav-link>
                <span class="text-link__line">查看放映详情</span>
                <Icon name="arrowUpRight" size={13} />
              </a>
            </div>

            {secondFilm && (
              <button
                class="cinema__next"
                type="button"
                data-open-video
                data-video-src={secondFilm.data.video}
                data-video-poster={secondFilm.data.cover}
                data-cursor-label="Play"
                data-reveal="right"
                style="--reveal-delay: .1s"
                aria-label={`播放短片：${secondFilm.data.title}`}
              >
                <span class="cinema__next-thumb">
                  <img src={secondFilm.data.cover} alt="" loading="lazy" width="1600" height="1000" />
                  <span class="cinema__next-play"><Icon name="play" size={15} /></span>
                </span>
                <span class="cinema__next-copy">
                  <span class="cinema__next-label">NEXT SCREENING</span>
                  <strong>{secondFilm.data.title}</strong>
                  <span>{secondFilm.data.duration} · {secondFilm.data.date}</span>
                </span>
                <Icon name="arrowUpRight" size={16} class="cinema__next-arrow" />
              </button>
            )}
          </aside>
        </div>
      </div>
    </section>
  )
}

<style>
  .cinema {
    position: relative;
    overflow: hidden;
    background: #08070b;
    border-block: 1px solid var(--line);
  }

  .cinema__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 55% at 30% 38%, rgba(142, 71, 82, 0.16), transparent 65%),
      radial-gradient(ellipse 40% 50% at 86% 74%, rgba(53, 94, 102, 0.12), transparent 65%);
    pointer-events: none;
  }

  .cinema__wash::before,
  .cinema__wash::after {
    content: "";
    position: absolute;
    top: -30%;
    width: 24%;
    height: 90%;
    background: linear-gradient(180deg, transparent, rgba(255, 228, 195, 0.06), transparent);
    transform: rotate(24deg);
  }
  .cinema__wash::before {
    left: 12%;
  }
  .cinema__wash::after {
    right: 18%;
    transform: rotate(-20deg);
  }

  .cinema__head {
    position: relative;
    z-index: 1;
    margin-bottom: clamp(50px, 6vw, 86px);
  }

  .cinema__stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(0, 0.68fr);
    gap: clamp(34px, 5vw, 80px);
    align-items: stretch;
  }

  .cinema__poster {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(243, 238, 227, 0.18);
    background: #000;
    text-align: left;
    box-shadow: 0 40px 110px rgba(0, 0, 0, 0.55);
    transition: border-color 0.5s ease, box-shadow 0.5s ease;
  }

  .cinema__poster:hover {
    border-color: rgba(255, 147, 166, 0.35);
    box-shadow: 0 50px 130px rgba(0, 0, 0, 0.65);
  }

  .cinema__poster > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease), filter 1s var(--ease);
  }

  .cinema__poster:hover > img {
    transform: scale(1.035);
    filter: brightness(1.06);
  }

  .cinema__poster-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.4), transparent 25%, transparent 55%, rgba(0, 0, 0, 0.82)),
      radial-gradient(circle at 50% 50%, transparent 30%, rgba(0, 0, 0, 0.28));
  }

  .cinema__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent 3px,
      rgba(0, 0, 0, 0.12) 4px
    );
    opacity: 0.35;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .cinema__film-edge {
    position: absolute;
    left: 0;
    right: 0;
    height: 13px;
    background:
      repeating-linear-gradient(90deg, transparent 0 12px, rgba(255, 255, 255, 0.17) 12px 20px, transparent 20px 32px);
    opacity: 0.55;
    pointer-events: none;
  }
  .cinema__film-edge--top {
    top: 0;
  }
  .cinema__film-edge--bottom {
    bottom: 0;
  }

  .cinema__poster-top {
    position: absolute;
    top: clamp(18px, 2.5vw, 32px);
    left: clamp(18px, 2.5vw, 32px);
    right: clamp(18px, 2.5vw, 32px);
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.18em;
    color: rgba(255, 253, 248, 0.68);
  }

  .cinema__rec {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .cinema__rec i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ff6275;
    box-shadow: 0 0 9px rgba(255, 98, 117, 0.8);
    animation: rec-blink 2.2s ease-in-out infinite;
  }

  @keyframes rec-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  .cinema__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(100px, 11vw, 150px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    transition: transform 0.7s var(--ease);
  }

  .cinema__poster:hover .cinema__play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .cinema__play-ring {
    position: absolute;
    inset: 0;
    color: rgba(255, 253, 248, 0.7);
  }

  .cinema__play-ring svg {
    width: 100%;
    height: 100%;
    animation: spin 22s linear infinite;
  }

  .cinema__play-ring text {
    font-family: var(--mono);
    font-size: 8.4px;
    letter-spacing: 0.2em;
    fill: currentColor;
  }

  .cinema__play-center {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(52px, 5.4vw, 72px);
    aspect-ratio: 1;
    margin: calc(clamp(52px, 5.4vw, 72px) / -2) 0 0 calc(clamp(52px, 5.4vw, 72px) / -2);
    border-radius: 50%;
    background: var(--white);
    color: #0d0d12;
    transition: background 0.4s ease, color 0.4s ease, transform 0.5s var(--ease);
  }

  .cinema__play-center svg {
    margin-left: 3px;
  }

  .cinema__poster:hover .cinema__play-center {
    background: var(--accent);
    transform: scale(1.08);
  }

  .cinema__poster-info {
    position: absolute;
    left: clamp(20px, 3vw, 40px);
    right: clamp(20px, 3vw, 40px);
    bottom: clamp(22px, 3vw, 40px);
    display: grid;
    gap: 6px;
  }

  .cinema__poster-category {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .cinema__poster-title {
    font-family: var(--serif);
    font-size: clamp(24px, 3.3vw, 50px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--white);
  }

  .cinema__poster-en {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.18em;
    color: rgba(255, 253, 248, 0.46);
  }

  .cinema__aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(30px, 4vw, 54px);
    padding-block: clamp(4px, 1vw, 14px);
  }

  .cinema__aside-quote {
    font-family: var(--serif);
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .cinema__aside-text {
    margin-top: 22px;
    font-size: 12px;
    line-height: 2;
    color: var(--ink-dim);
  }

  .cinema__meta-list {
    display: grid;
    gap: 0;
    margin-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--line);
  }

  .cinema__meta-list div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }

  .cinema__meta-list span {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
  }

  .cinema__meta-list strong {
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .cinema__detail-link {
    margin-top: 24px;
  }

  .cinema__next {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    width: 100%;
    padding: 10px;
    border: 1px solid var(--line);
    background: rgba(243, 238, 227, 0.025);
    text-align: left;
    transition: background 0.4s ease, border-color 0.4s ease;
  }

  .cinema__next:hover {
    background: rgba(243, 238, 227, 0.06);
    border-color: var(--line-strong);
  }

  .cinema__next-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
  }

  .cinema__next-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }

  .cinema__next:hover .cinema__next-thumb img {
    transform: scale(1.06);
  }

  .cinema__next-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(4, 5, 9, 0.3);
    color: var(--white);
  }

  .cinema__next-copy {
    display: grid;
    gap: 5px;
  }

  .cinema__next-label {
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.18em;
    color: var(--accent);
  }

  .cinema__next-copy strong {
    font-family: var(--serif);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.03em;
  }

  .cinema__next-copy span:last-child {
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .cinema__next-arrow {
    color: var(--ink-faint);
    transition: transform 0.4s var(--ease), color 0.4s ease;
  }

  .cinema__next:hover .cinema__next-arrow {
    transform: translate(2px, -2px);
    color: var(--ink);
  }

  @media (max-width: 1050px) {
    .cinema__stage {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .cinema__aside {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 30px;
    }
    .cinema__next {
      align-self: end;
    }
  }

  @media (max-width: 700px) {
    .cinema__aside {
      grid-template-columns: 1fr;
    }
    .cinema__aside-quote br {
      display: none;
    }
    .cinema__poster-top {
      font-size: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cinema__play-ring svg,
    .cinema__rec i {
      animation: none;
    }
  }
</style>
