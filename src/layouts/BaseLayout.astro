---
import '@fontsource-variable/inter';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import Cursor from '../components/Cursor.astro';
import Lightbox from '../components/Lightbox.astro';
import VideoModal from '../components/VideoModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  page?: string;
  noIndex?: boolean;
}

const {
  title,
  description = '跨次元新星是山东省济钢高级中学（全福校区）的艺术类动漫社团——以动画影像艺术为载体开展美育学习，收藏插画、短篇小说与概念影像。在画格之间，让想象发光。',
  image = '/og.jpg',
  page = 'default',
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} — 跨次元新星` : '跨次元新星 · 山东省济钢高级中学（全福校区）动漫社';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '跨次元新星',
  alternateName: 'Cross-Dimension Nova',
  description,
  foundingDate: '2026',
  address: {
    '@type': 'PostalAddress',
    addressLocality: '济南',
    addressRegion: '山东',
    addressCountry: 'CN',
  },
  memberOf: {
    '@type': 'EducationalOrganization',
    name: '山东省济钢高级中学（全福校区）',
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="跨次元新星动漫社" />
    <meta name="theme-color" content="#07080d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/art/stardust-tram.svg" as="image" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="跨次元新星" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          if (sessionStorage.getItem('nova-intro-played') === '1') {
            document.documentElement.classList.add('skip-preloader');
          }
        } catch (e) {}
      })();

      // If the module bundle ever fails to load, never trap the page behind the intro.
      setTimeout(() => {
        const preloader = document.querySelector('[data-preloader]');
        if (preloader && !document.documentElement.classList.contains('skip-preloader')) {
          preloader.remove();
          document.body?.classList.remove('preloading');
        }
      }, 7000);
    </script>

    <ClientRouter />
  </head>

  <body data-page={page}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <noscript>
      <style>
        .preloader { display: none !important; }
        .js [data-reveal], .js [data-reveal-group] > * { opacity: 1 !important; transform: none !important; }
        .line-mask > span { transform: none !important; }
      </style>
    </noscript>

    <Preloader />
    <Cursor />
    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <Lightbox />
    <VideoModal />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
